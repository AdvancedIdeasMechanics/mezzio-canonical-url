{
  "name": "advancedideasmechanics/mezzio-canonical-url",
  "description": "Automated PSR-7 Canonical URL middleware for Mezzio applications using Laminas-View.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthew Pallotta",
      "email": "matt@advanced.im"
    }
  ],
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "psr/http-server-middleware": "^1.0",
    "mezzio/mezzio-template": "^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "AdvancedIdeasMechanics\\MezzioCanonicalUrl\\": "src/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "AdvancedIdeasMechanics\\MezzioCanonicalUrl\\ConfigProvider"
    }
  }
}